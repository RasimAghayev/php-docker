{
    "name": "rasimaghayev/php-docker",
    "description": "A Docker demo app for gRasim Aghayev",
    "minimum-stability": "stable",
    "license": "MIT",
    "authors": [
      {
        "name": "Rasim Aghayev",
        "email": "rasimaghayev@gmail.com"
      }
    ],
    "require": {
      "php": "^8.4",
      "ext-pdo": "*",
      "ext-pdo_mysql": "*",
      "symfony/cache": "^8.0",
      "predis/predis": "^3.0"
    },
    "require-dev": {
      "phpunit/phpunit": "^13.0",
      "nunomaduro/collision": "^8.0"
    },
    "autoload": {
      "psr-4": {
        "App\\": "src"
      }
    },
    "scripts": {
      "run-phpunit": "vendor/bin/phpunit"
    }
  }